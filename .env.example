# Copy this file to .env and fill in what you need. NEVER commit .env.
# Everything is optional: loopfund runs fully local with NO keys at all.
# You can also set keys later from the dashboard Settings tab instead of here.

# ============================================================================
# MODEL BACKEND
# Pick a backend in config/models.yaml (default: "local" = LM Studio, no key).
# Only fill the section for the backend you actually use.
# ============================================================================

# --- Local backends (no API key needed) ---
# LM Studio (default). Start it, load a model, enable the local server.
LOCAL_BASE_URL=http://localhost:1234/v1
# Ollama (run `ollama serve`, then `ollama pull llama3.1`).
OLLAMA_BASE_URL=http://localhost:11434/v1
# vLLM / LocalAI / any other OpenAI-compatible server.
VLLM_BASE_URL=http://localhost:8000/v1

# --- Cloud backends (need a key; leave blank to disable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# (GOOGLE_API_KEY also works for Gemini.)
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# Qwen Cloud (Alibaba Model Studio / DashScope), OpenAI-compatible.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional: override any cloud endpoint (self-hosted gateways, proxies, regions).
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# ============================================================================
# DATA SOURCES (all optional, all free tiers — blank = that source disabled)
# ============================================================================
FRED_API_KEY=
# Reddit app credentials (free): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=loopfund/0.1 by your-username
# SEC EDGAR requires a descriptive User-Agent that includes contact info.
SEC_USER_AGENT=loopfund/0.1 your-email@example.com

# ============================================================================
# DASHBOARD / RUNTIME (optional)
# ============================================================================
# LOOPFUND_HOST=127.0.0.1
# LOOPFUND_PORT=8500
# Set to 1 to NOT auto-open the browser when the dashboard starts.
# LOOPFUND_NO_BROWSER=0
# Set to a number of seconds to auto-run the 24/7 research loop on boot.
# LOOPFUND_AUTOLOOP=1800

# ============================================================================
# ADVANCED / SAFETY GATES (leave unset unless you know you want them)
# ============================================================================
# Allow the optional QuantResearch agent to run model-authored Python WITHOUT an
# OS sandbox (Linux/Windows have none). Off = code execution is refused there.
# LOOPFUND_ALLOW_UNSANDBOXED=0
# Live trading is unimplemented and double-gated. This var is one of the two locks
# (the other is mode=live in settings.yaml). Do NOT set it. There is no real broker.
# LOOPFUND_ALLOW_LIVE=0
